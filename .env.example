DATA_MODE=demo
NEO4J_URI=neo4j+s://YOUR-INSTANCE.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j
# Optional: run npm run embeddings, then enable semantic search
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small

# Own catalog: DATA_MODE=file (or import into neo4j)
GRAPH_FILE=.data/catalog.json
# PostgreSQL source, used only by npm run collect:postgres
SOURCE_DATABASE_URL=
